{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "mouse": true,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",      // Adapts to terminal width (stacked vs side-by-side)
  "keybinds": {
    "leader": "ctrl+x"      // Change this if it conflicts with your Vim/Tmux
  }
}
