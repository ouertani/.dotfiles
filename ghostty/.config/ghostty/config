# ==========================================
# Theme & Color Setup
# ==========================================
theme = Gruvbox Dark

# ==========================================
# Font & Sharpness (1440p Calibration)
# ==========================================
font-family = "JetBrains Mono"
font-size = 20
font-style = "Medium"

# Enables CoreText stem darkening so thin vertical strokes don't drop pixels
font-thicken = false

# Font Features (OpenType ligatures)
font-feature = calt
font-feature = liga
font-feature = dlig

# Grid Alignment (Matches VS Code line rhythm)
adjust-cell-height = 10%
adjust-cell-width = 0

# ==========================================
# Window & Layout
# ==========================================
window-decoration = false

window-padding-x = 24
window-padding-y = 20

split-divider-color = #3c3836
unfocused-split-opacity = 0.95

# ==========================================
# Interaction & Shell
# ==========================================
mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false
shell-integration = zsh
macos-option-as-alt = true

custom-shader = ~/.config/ghostty/shaders/cursor.glsl