{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "omlx/Qwen3.6-35B-A3B-6bit",
  "instructions": [
    "~/.config/opencode/rules/rust.md",
    "~/.config/opencode/rules/context7.md",
    "~/.config/opencode/rules/workflow.md"
  ],
  "permission": {
    "external_directory": {
      "~/.cargo/registry/**": "allow",
      "~/.cargo/git/checkouts/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": 16000,
    "keep": {
      "tokens": 8000
    }
  },
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OMLX",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.8-27B-8bit": {
          "name": "Qwen 3.8 27B 8-bit",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "Qwen3.6-35B-A3B-8bit": {
          "name": "Qwen3.6-35B-A3B-8bit",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "Qwen3.6-35B-A3B-6bit": {
          "name": "Qwen3.6-35B-A3B-6bit",
          "limit": {
            "context": 98304,
            "output": 8192
          }
        },
        "Qwen3.6-35B-A3B-4bit": {
          "name": "Qwen3.6-35B-A3B-4bit",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "mycorr": {
      "type": "remote",
      "enable": false,
      "url": "https://space.mycorr.app/mcp",
      "headers": {
        "MYCORR_API_TOKEN": "{env:MYCORR_API_TOKEN}"
      }
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false
    }
  }
}
