# ==========================================
# Theme
# ==========================================
theme = Gruvbox Dark

# ==========================================
# Font & Sharpness (Dell 49" 1440p)
# ==========================================
font-family = "JetBrains Mono"
font-size = 18

# macOS CoreText stroke weight tuning
font-thicken = true
font-thicken-strength = 90

# Physical pixel cell padding (prevents compressed rows)
adjust-cell-height = 4

# ==========================================
# Window & Layout
# ==========================================
window-decoration = false
title = " "

window-padding-x = 24
window-padding-y = 20

# Split border color matching Gruvbox Dark palette
split-divider-color = #3c3836
unfocused-split-opacity = 0.95

# ==========================================
# Interaction & Shell
# ==========================================
mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false
shell-integration = zsh
macos-option-as-alt = true

# Custom Shader
custom-shader = ~/.config/ghostty/shaders/cursor.glsl